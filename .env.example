# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Private signing key for secure user authentication sessions.
JWT_SECRET="qa_toolkit_super_secret_for_signing_jwts_2026"

# ADMIN_EMAIL: the ONLY account that is ever granted admin rights, regardless of any
# is_admin flag stored per-user. Checked fresh on every request — not toggleable via the UI.
ADMIN_EMAIL=""

# DATABASE_URL: Neon Postgres connection string (Render backend env var).
# Get it from your Neon project dashboard — looks like:
# postgres://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# If left blank, the app falls back to the local qa_interview_kit_db.json file (dev only —
# do NOT deploy to Render without this set, its filesystem is ephemeral and resets on redeploy).
DATABASE_URL=""

# CORS_ORIGIN: comma-separated list of frontend origins allowed to call this API
# (set on the Render backend). Example: "https://your-app.vercel.app,https://yourdomain.com"
# Leave blank during local dev — same-origin requests don't need it.
CORS_ORIGIN=""

# VITE_API_URL: the Render backend's public URL (set as a Vercel FRONTEND env var, not here).
# Example: "https://your-backend.onrender.com". Leave blank for local dev / same-origin deploys.
VITE_API_URL=""

# RAZORPAY_KEY_ID: Razorpay Merchant Account key identifier (starts with rzp_test_ or rzp_live_).
# Leave blank to enable payment sandbox simulator mode for zero-setup reviews!
RAZORPAY_KEY_ID=""

# RAZORPAY_KEY_SECRET: Secure merchant secret key from Razorpay merchant dashboard.
RAZORPAY_KEY_SECRET=""

# SENDGRID_API_KEY: if set, email is sent via SendGrid's HTTP API (checked first,
# before BREVO_API_KEY and SMTP below). No IP-allowlist restriction — recommended
# for hosts with shared/dynamic outbound IPs (e.g. Render's free tier).
# Get it from app.sendgrid.com -> Settings -> API Keys, after verifying your sender
# address under Settings -> Sender Authentication -> Single Sender Verification.
SENDGRID_API_KEY=""

# BREVO_API_KEY: if set (and SENDGRID_API_KEY is not), email is sent via Brevo's HTTP
# API instead of SMTP. Note: unlike SendGrid, Brevo's account-level IP allowlist can
# still block this path too — see SENDGRID_API_KEY above for the recommended option.
BREVO_API_KEY=""

# SMTP Configuration: used only if BREVO_API_KEY is not set. Required for login/signup
# OTP + verification emails to work when relying on SMTP instead of the API above.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<16-char App Password from https://myaccount.google.com/apppasswords>
# (App Passwords require 2-Step Verification enabled on the Google account first.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="QA Interview Kit <no-reply@qakit.com>"
